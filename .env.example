# ─────────────────────────────────────────────────────────────
# Cuentas Conmigo — variables de entorno
# Copia este archivo a .env.local y rellena los valores:
#   cp .env.example .env.local
# .env.local NUNCA se versiona (ver .gitignore).
#
# Regla: jamás uses el prefijo NEXT_PUBLIC_ para una clave secreta.
# Todo lo que empieza con NEXT_PUBLIC_ termina en el bundle del cliente.
# ─────────────────────────────────────────────────────────────

# ── Supabase (públicas: seguras en el cliente, protegidas por RLS) ──
NEXT_PUBLIC_SUPABASE_URL=
# Anon key, o publishable key si el proyecto usa las llaves nuevas
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase (SOLO servidor) ──
# Service role key, o secret key. Salta RLS: nunca al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ── Anthropic (SOLO servidor) ──
# Modelo de runtime: claude-haiku-4-5-20251001
# Configura un límite de gasto mensual en la consola de Anthropic.
ANTHROPIC_API_KEY=

# ── Crons de Vercel (SOLO servidor) ──
# Vercel lo manda como "Authorization: Bearer <CRON_SECRET>" a /api/cron/*
# Genera uno con: openssl rand -hex 32
CRON_SECRET=
